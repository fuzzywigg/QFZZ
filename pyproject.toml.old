[build-system]
requires = ["setuptools>=45", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "qfzz"
version = "0.1.0"
description = "QFZZ: The Pulse of the Quantum Realm - AI Radio for the Individual"
readme = "README.md"
requires-python = ">=3.8"
license = {text = "MIT"}
authors = [
    {name = "QFZZ Team"}
]
keywords = ["ai", "radio", "llm", "edge-computing", "blockchain", "6g"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.8",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
]

[project.urls]
Homepage = "https://github.com/fuzzywigg/QFZZ"
Repository = "https://github.com/fuzzywigg/QFZZ"

[project.scripts]
qfzz = "main:main"
