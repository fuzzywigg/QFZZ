# =============================================================================
# QFZZ Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual API keys and configuration
#
# IMPORTANT: Never commit .env files to version control!
# The .env file contains sensitive credentials and should remain local.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# QFZZ uses multiple LLM providers with automatic fallback
# Fallback chain: Google Gemini → Groq → Anthropic → OpenAI → Ollama (local)
#
# You can configure any combination of providers:
# - Minimum: Just GOOGLE_AI_API_KEY for basic functionality
# - Recommended: GOOGLE_AI_API_KEY + GROQ_API_KEY (free tier backup)
# - Best: All providers for maximum reliability
# - Local only: Just Ollama (no API keys needed)
# -----------------------------------------------------------------------------

# Google Gemini (Primary Provider)
# Get your API key: https://makersuite.google.com/app/apikey
# Cost: ~$0.000075 per 1K tokens (Gemini Flash)
GOOGLE_AI_API_KEY=your_google_api_key_here
GOOGLE_AI_MODEL_DEFAULT=gemini-2.0-flash-exp

# Groq (Fast Inference API - FREE TIER)
# Get your API key: https://console.groq.com
# Cost: Free tier available, then pay-as-you-go
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (High Quality Responses)
# Get your API key: https://console.anthropic.com
# Cost: ~$0.003 per 1K tokens (Claude Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_DEFAULT=claude-3-5-sonnet-20241022

# OpenAI (GPT Models)
# Get your API key: https://platform.openai.com/api-keys
# Cost: ~$0.00015 per 1K tokens (GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# Ollama (Local LLM - NO API KEY NEEDED)
# Install: https://ollama.ai
# Cost: $0 (runs locally on your machine)
# Usage: ollama pull mistral:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=mistral:7b-instruct

# -----------------------------------------------------------------------------
# Music Source APIs (Optional - for content fetching)
# -----------------------------------------------------------------------------

# Jamendo Music API
# Get your client ID: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Internet Archive API
# Get your keys: https://archive.org/account/s3.php
INTERNET_ARCHIVE_ACCESS_KEY=your_ia_access_key_here
INTERNET_ARCHIVE_SECRET_KEY=your_ia_secret_key_here

# -----------------------------------------------------------------------------
# QFZZ Station Configuration
# -----------------------------------------------------------------------------

# Station Settings
QFZZ_STATION_NAME=My QFZZ Station
QFZZ_STATION_PORT=8080

# Feature Flags
QFZZ_ENABLE_BLOCKCHAIN=true
QFZZ_ENABLE_EDGE_OPTIMIZATION=true
QFZZ_ENABLE_6G=false

# Paths
QFZZ_AUDIO_CONTENT_DIR=./qfzz_audio_content
QFZZ_CACHE_DIR=./cache
QFZZ_HONEYCOMB_DIR=./honeycomb
QFZZ_LEDGER_FILE=./qfzz_ledger.json

# -----------------------------------------------------------------------------
# Logging and Debug
# -----------------------------------------------------------------------------

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=./logs/qfzz.log

# Enable debug mode (verbose logging)
DEBUG=false

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# LLM Router Configuration
LLM_ROUTER_CONFIG_PATH=config/llm-router-config.json

# Cost Tracking
LLM_MAX_COST_PER_REQUEST=0.01
LLM_PREFER_CHEAP_PROVIDERS=true

# Honeycomb State Management
HONEYCOMB_LOCK_TIMEOUT=10

# Dataset Management
DATASET_MIN_QUALITY=0.7
DATASET_STRICT_LICENSING=true
DATASET_CACHE_EXPIRY_DAYS=30

# Blockchain Settings
BLOCKCHAIN_DIFFICULTY=2
BLOCKCHAIN_ENABLE_MINING=true

# Edge Optimization
EDGE_MAX_MEMORY_MB=512
EDGE_MAX_MODEL_SIZE_MB=100
EDGE_DEFAULT_QUALITY=balanced
