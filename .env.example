# QFZZ Configuration Example
# Copy this file to .env and fill in your values

# === Station Configuration ===
QFZZ_STATION_NAME=QFZZ
QFZZ_AUDIO_CONTENT_DIR=./qfzz_audio_content
QFZZ_CACHE_DIR=./cache
QFZZ_PORT=8080

# === LLM Provider Configuration ===
# Ollama (Local, Free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini API (Free tier available)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Groq API (Free tier available)
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# Together.ai API (Free tier available)
# Get your key at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# HuggingFace Inference API (Free tier available)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# === Music Source APIs ===
# Jamendo API (Free, Creative Commons music)
# Get your key at: https://developer.jamendo.com/
JAMENDO_CLIENT_ID=

# Internet Archive API (Free, Public Domain)
# Optional: Improves rate limits
INTERNET_ARCHIVE_ACCESS_KEY=
INTERNET_ARCHIVE_SECRET_KEY=

# === Blockchain Configuration ===
QFZZ_BLOCKCHAIN_ENABLED=true
QFZZ_LEDGER_FILE=./qfzz_ledger.json

# === Edge Configuration ===
QFZZ_EDGE_MODE=false
QFZZ_ENABLE_6G=false

# === Logging ===
QFZZ_LOG_LEVEL=INFO
QFZZ_LOG_FILE=./logs/qfzz.log

# === Advanced Options ===
# Content licensing strict mode
QFZZ_STRICT_LICENSING=true

# Dataset cache expiry (days)
QFZZ_CACHE_EXPIRY_DAYS=30

# Maximum concurrent downloads
QFZZ_MAX_DOWNLOADS=3
