{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["track_id", "title", "artist", "added_at"]
      }
    }
  },
  "required": ["queue"]
}
