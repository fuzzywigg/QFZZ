{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "processing", "completed", "failed"]
          }
        },
        "required": ["task_id", "action", "created_at", "status"]
      }
    }
  },
  "required": ["pending"]
}
